# Copy to .env and fill in for LIVE mode. Demo mode needs none of these.

# Required for live transcription. Get one at https://console.deepgram.com
DEEPGRAM_API_KEY=

# Optional. With it, live-mode question suggestions use claude-haiku-4-5.
# Without it, live still transcribes and uses the offline suggestion engine.
ANTHROPIC_API_KEY=

# Optional overrides
# PORT=5173
# DEEPGRAM_MODEL=nova-3
