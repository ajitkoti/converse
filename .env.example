# Copy to .env and fill in. Demo mode needs none of these.

# --- Live transcription (required for "Go live") ---
# Get one at https://console.deepgram.com
DEEPGRAM_API_KEY=

# Optional. With it, live-mode suggestions use claude-haiku-4-5.
# Without it, live still transcribes and uses the offline suggestion engine.
ANTHROPIC_API_KEY=

# --- Google Drive export (optional) ---
# Easiest: create an OAuth client (type "Desktop app") in Google Cloud Console,
# download the json, point this at it, then run:  npm run connect-drive
GOOGLE_OAUTH_CLIENT=

# Alternative to OAuth: a service-account json (share your Drive folder with its email)
# GOOGLE_APPLICATION_CREDENTIALS=

# Upload target folder id (blank = the app auto-creates/uses "Converse Sessions")
# GDRIVE_FOLDER_ID=

# --- Misc ---
# PORT=5173
# DEEPGRAM_MODEL=nova-3
