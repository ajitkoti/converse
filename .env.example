# Copy to .env and fill in. Demo mode needs none of these.

# --- Live transcription (required for "Go live") ---
# Get one at https://console.deepgram.com
DEEPGRAM_API_KEY=

# LLM for live suggestions — set ONE of these (or enter it in Settings).
# Pick the provider in Settings → AI provider. Without a key, live still
# transcribes and uses the offline suggestion engine.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Google Drive export (optional) ---
# Create an OAuth client (type "Web application" OR "Desktop app") in Google
# Cloud Console and point this at the downloaded json. Add this app's callback
# as an authorized redirect URI:  http://localhost:5173/oauth2callback
# Then click "Connect Google Drive" in Settings (no terminal needed), or run
# `npm run connect-drive`.
GOOGLE_OAUTH_CLIENT=

# Alternative to OAuth: a service-account json (share your Drive folder with its email)
# GOOGLE_APPLICATION_CREDENTIALS=

# Upload target folder id (blank = the app auto-creates/uses "Converse Sessions")
# GDRIVE_FOLDER_ID=

# --- Misc ---
# PORT=5173
# DEEPGRAM_MODEL=nova-3
